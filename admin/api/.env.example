PORT=8090
# Resolved relative to prisma/schema.prisma (Prisma's convention for sqlite file: URLs),
# i.e. this ends up at admin/api/prisma/var/admin.db - not admin/api/var/.
DATABASE_URL="file:./var/admin.db"
JWT_SECRET=change-me-to-a-long-random-string
JWT_COOKIE_NAME=krd_admin_session

# Where the proxy server (server/) is reachable, for the live vehicles/health views.
PROXY_URL=http://localhost:8080

# Where admin/web is served from, for CORS + cookie SameSite.
WEB_ORIGIN=http://localhost:3000

# Where the passenger app (passenger/client) is served from, for CORS.
APP_ORIGIN=http://localhost:3100

PORT=8080
POLL_INTERVAL_MS=5000
HISTORY_RETENTION_DAYS=14
YANDEX_RASP_API_KEY=

# Note: the portal's server doesn't send its intermediate TLS certificate, so Node
# can't verify the chain on its own (curl works because it uses the OS trust store
# instead). The fix (NODE_EXTRA_CA_CERTS pointing at certs/) is wired into the
# "start"/"dev" scripts in package.json directly, not here - Node reads that
# variable too early in its own startup for --env-file to affect it in time.
